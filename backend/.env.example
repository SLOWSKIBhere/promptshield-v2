# ─── Required ───────────────────────────────────────────────────────────────
# Set the credential for the direct provider you intend to scan. Custom HTTP
# targets can run without one and fall back to heuristic judging when needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────
# Set this in production to lock down CORS
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_PATH=promptshield.db
ANTHROPIC_TARGET_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5-20251001
OPENAI_TARGET_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini
GROQ_TARGET_MODEL=llama-3.1-8b-instant
GROQ_JUDGE_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
TARGET_PROVIDER=auto
JUDGE_PROVIDER=auto
# Timeout applied to custom target endpoint requests.
TARGET_TIMEOUT_SECONDS=30
# Timeout applied to direct provider and external judge requests.
PROVIDER_TIMEOUT_SECONDS=60
# Development only. Never enable this in production.
ALLOW_PRIVATE_TARGETS=false
# Keep unset for local browser development.
PROMPTSHIELD_API_KEY=

# ─── Frontend (Vercel env vars) ───────────────────────────────────────────────
# VITE_API_URL=https://your-backend.railway.app
